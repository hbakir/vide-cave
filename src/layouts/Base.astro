---
import { site, vendeur } from "../config";
const { titre = site.titre } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <style is:global>
      :root { --encre:#2B2F33; --ardoise:#5E6B73; --fond:#FAF8F5; --accent:#B26A2B; }
      * { box-sizing: border-box; }
      body { margin:0; font-family: system-ui, sans-serif; color:var(--encre); background:var(--fond); line-height:1.5; }
      header, main, footer { max-width: 960px; margin: 0 auto; padding: 1rem; }
      header a { color:inherit; text-decoration:none; }
      h1 { margin:.2rem 0; }
      .accroche, footer { color:var(--ardoise); }
      footer { font-size:.9rem; border-top:1px solid #ddd; margin-top:2rem; }
      footer a { color:var(--ardoise); }
    </style>
  </head>
  <body>
    <header>
      <a href="/"><h1>{site.titre}</h1></a>
      <p class="accroche">{site.accroche}</p>
    </header>
    <main><slot /></main>
    <footer>
      Vente privée par {vendeur.nom}, {vendeur.localite} · Objets vendus en l'état, sans garantie ·
      <a href="/qui-vend">Qui vend ?</a> · <a href="/donnees">Vos données</a>
    </footer>
  </body>
</html>
